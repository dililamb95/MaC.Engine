<Window x:Class="MaCProFunding.AddOn.MaCProFundingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MaCProFunding.AddOn"
        Title="MaCPro Funding"
        Width="1060"
        Height="740"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#0D0F12"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary
                Source="Themes/MaCProGlassTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="WindowBackground" Color="#0D0F12"/>
            <SolidColorBrush x:Key="WorkspaceBackground" Color="#111315"/>
            <SolidColorBrush x:Key="SidebarBackground" Color="#0B0D10"/>
            <SolidColorBrush x:Key="CardBackground" Color="#171A1F"/>
            <SolidColorBrush x:Key="CardSecondaryBackground" Color="#1B1E23"/>
            <SolidColorBrush x:Key="BorderBrushDark" Color="#2A2E35"/>
            <SolidColorBrush x:Key="PrimaryText" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="SecondaryText" Color="#A7ACB5"/>
            <SolidColorBrush x:Key="MutedText" Color="#737A86"/>
            <SolidColorBrush x:Key="GoldLight" Color="#F8DF78"/>
            <SolidColorBrush x:Key="GoldMedium" Color="#D4A017"/>
            <SolidColorBrush x:Key="GoldDark" Color="#895500"/>
            <SolidColorBrush x:Key="Green" Color="#22C55E"/>
            <SolidColorBrush x:Key="Red" Color="#EF4444"/>
            <SolidColorBrush x:Key="Orange" Color="#FF7A00"/>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="18"/>
            </Style>

            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="CardValue" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
                <Setter Property="FontSize" Value="25"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,7,0,0"/>
            </Style>

            <Style x:Key="HelperText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="0,6,0,0"/>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Height" Value="42"/>
                <Setter Property="MinWidth" Value="154"/>
                <Setter Property="Padding" Value="18,0"/>
                <Setter Property="Background" Value="{StaticResource GoldMedium}"/>
                <Setter Property="Foreground" Value="#1E1505"/>
                <Setter Property="BorderBrush" Value="{StaticResource GoldDark}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource GoldLight}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource GoldDark}"/>
                                    <Setter Property="Foreground" Value="{StaticResource GoldLight}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AccountSelectorItemStyle" TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="12,9"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="ItemChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="ItemChrome" Property="Background" Value="#252A31"/>
                                    <Setter Property="Foreground" Value="{StaticResource GoldLight}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemChrome" Property="Background" Value="#211B10"/>
                                    <Setter Property="Foreground" Value="{StaticResource GoldLight}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AccountSelectorStyle" TargetType="ComboBox">
                <Setter Property="Height" Value="42"/>
                <Setter Property="Padding" Value="13,0,42,0"/>
                <Setter Property="Background" Value="#15181C"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource AccountSelectorItemStyle}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="SelectorChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9"/>

                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              IsHitTestVisible="False"/>

                                <ToggleButton x:Name="DropDownToggle"
                                          Width="38"
                                          HorizontalAlignment="Right"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" CornerRadius="0,9,9,0">
                                                <Path Data="M 0 0 L 4 4 L 8 0"
                                                  Stroke="{StaticResource GoldMedium}"
                                                  StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                    <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="300"
                                        Margin="0,5,0,0"
                                        Background="#15181C"
                                        BorderBrush="{StaticResource BorderBrushDark}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="5">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SelectorChrome" Property="BorderBrush" Value="{StaticResource GoldMedium}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="SelectorChrome" Property="BorderBrush" Value="{StaticResource GoldMedium}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="SelectorChrome" Property="Opacity" Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ModernProgress" TargetType="ProgressBar">
                <Setter Property="Height" Value="7"/>
                <Setter Property="Background" Value="#262A31"/>
                <Setter Property="Foreground"
        Value="{StaticResource Green}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid SnapsToDevicePixels="True">
                                <Border x:Name="PART_Track"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"/>
                                <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="4"
                                    HorizontalAlignment="Left"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NavText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>

        <Grid.Background>

            <LinearGradientBrush StartPoint="0,0"
                             EndPoint="1,1">

                <GradientStop Color="#071018"
                          Offset="0"/>

                <GradientStop Color="#0B111A"
                          Offset="0.45"/>

                <GradientStop Color="#090C12"
                          Offset="1"/>

            </LinearGradientBrush>

        </Grid.Background>
        <Border Grid.Column="0" Background="#98091118" BorderBrush="#1F2227" BorderThickness="0,0,1,0">
            <Grid Margin="20,22,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Image Source="MaCProFundingLogo.png"
                           Width="194"
                           Height="74"
                           Stretch="Uniform"
                           HorizontalAlignment="Left"/>
                    <TextBlock Text="TRADING EVALUATION"
                               Foreground="{StaticResource MutedText}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="2,8,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Border Background="#211B10" BorderBrush="#4A3511" BorderThickness="1" CornerRadius="10" Padding="13,11" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="4" Background="{StaticResource GoldMedium}" CornerRadius="2"/>
                            <TextBlock Grid.Column="2" Text="Dashboard" Foreground="{StaticResource GoldLight}" FontSize="13" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>
                    <Border CornerRadius="10" Padding="13,10" Margin="0,2">
                        <TextBlock Style="{StaticResource NavText}" Text="Analytics"/>
                    </Border>
                    <Border CornerRadius="10" Padding="13,10" Margin="0,2">
                        <TextBlock Style="{StaticResource NavText}" Text="Trades"/>
                    </Border>
                    <Border CornerRadius="10" Padding="13,10" Margin="0,2">
                        <TextBlock Style="{StaticResource NavText}" Text="Rules"/>
                    </Border>
                    <Border CornerRadius="10" Padding="13,10" Margin="0,2">
                        <TextBlock Style="{StaticResource NavText}" Text="Contracts"/>
                    </Border>
                    <Border CornerRadius="10" Padding="13,10" Margin="0,2">
                        <TextBlock Style="{StaticResource NavText}" Text="Settings"/>
                    </Border>
                </StackPanel>

                <Border Grid.Row="4" Background="#14171B" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="12" Padding="13">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="8" Height="8" Background="{StaticResource Green}" CornerRadius="4" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="MaC Engine connected" Foreground="{StaticResource SecondaryText}" FontSize="11" FontWeight="SemiBold"/>
                        </Grid>
                        <TextBlock Text="Dashboard v2.0" Foreground="{StaticResource MutedText}" FontSize="10" Margin="16,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- =====================================================
     PREMIUM HEADER
     ===================================================== -->

            <Border Grid.Row="0"
        Background="#E60A1018"
        BorderBrush="{StaticResource GlassBorderSoft}"
        BorderThickness="0,0,0,1"
        Padding="28,17">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT SIDE -->

                    <StackPanel Grid.Column="0"
                    VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal">

                            <Border Background="#2BF7BC32"
                        BorderBrush="#70F7BC32"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="9,4"
                        VerticalAlignment="Center">

                                <TextBlock Text="MACPRO TERMINAL"
                               Foreground="{StaticResource AccentGoldLight}"
                               FontSize="9"
                               FontWeight="Bold"/>


                            </Border>

                            <Border Width="1"
                        Height="17"
                        Background="{StaticResource GlassBorder}"
                        Margin="12,0"
                        VerticalAlignment="Center"/>

                            <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                                <Border Width="8"
                            Height="8"
                            Background="{StaticResource AccentGreen}"
                            CornerRadius="4"
                            VerticalAlignment="Center">

                                    <Border.Effect>

                                        <DropShadowEffect Color="#26E875"
                                              BlurRadius="10"
                                              ShadowDepth="0"
                                              Opacity="0.75"/>

                                    </Border.Effect>

                                </Border>

                                <TextBlock Text="LIVE DATA"
                               Foreground="{StaticResource GlassSecondaryText}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="7,0,0,0"
                               VerticalAlignment="Center"/>

                            </StackPanel>

                        </StackPanel>

                        <TextBlock Text="Evaluation Dashboard"
                       Foreground="{StaticResource GlassPrimaryText}"
                       FontSize="25"
                       FontWeight="SemiBold"
                       Margin="0,9,0,0"/>

                        <TextBlock Text="Real-time account performance, risk and evaluation progress"
                       Foreground="{StaticResource GlassMutedText}"
                       FontSize="11"
                       Margin="0,4,0,0"/>

                    </StackPanel>

                    <!-- ACCOUNT SELECTOR -->

                    <StackPanel Grid.Column="2"
                    VerticalAlignment="Center">

                        <TextBlock Text="SELECTED TRADING ACCOUNT"
                       Foreground="{StaticResource GlassMutedText}"
                       FontSize="9"
                       FontWeight="SemiBold"
                       Margin="2,0,0,6"/>

                        <Border Background="#B5121922"
                    BorderBrush="{StaticResource GlassBorderSoft}"
                    BorderThickness="1"
                    CornerRadius="11">

                            <ComboBox x:Name="AccountSelector"
                          Height="44"
                          Style="{StaticResource AccountSelectorStyle}"
                          Background="Transparent"
                          BorderThickness="0"
                          SelectionChanged="OnAccountSelectionChanged"/>

                        </Border>

                    </StackPanel>

                    <!-- REFRESH BUTTON -->

                    <Button x:Name="RefreshAccountsButton"
        Grid.Column="4"
        Height="44"
        MinWidth="166"
        Padding="20,0"
        Background="{StaticResource GoldMedium}"
        Foreground="#1E1505"
        BorderBrush="{StaticResource GoldDark}"
        BorderThickness="1"
        FontSize="11"
        FontWeight="Bold"
        Cursor="Hand"
        VerticalAlignment="Bottom"
        Click="OnRefreshAccountsClick">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border x:Name="RefreshButtonChrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="22"
                    Padding="{TemplateBinding Padding}">

                                    <TextBlock Text="REFRESH ACCOUNTS"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="11"
                           FontWeight="Bold"/>

                                </Border>

                                <ControlTemplate.Triggers>

                                    <Trigger Property="IsMouseOver"
                         Value="True">

                                        <Setter TargetName="RefreshButtonChrome"
                            Property="Background"
                            Value="{StaticResource GoldLight}"/>

                                    </Trigger>

                                    <Trigger Property="IsPressed"
                         Value="True">

                                        <Setter TargetName="RefreshButtonChrome"
                            Property="Background"
                            Value="{StaticResource GoldDark}"/>

                                        <Setter Property="Foreground"
                            Value="{StaticResource GoldLight}"/>

                                    </Trigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>
                        </Button.Template>

                    </Button>

                </Grid>

            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="28,24,28,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="22">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CURRENT EVALUATION" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="AccountNameText" Text="Sin cuenta conectada" Foreground="{StaticResource PrimaryText}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <TextBlock x:Name="NinjaAccountNameText" Text="Sin cuenta NinjaTrader" Foreground="{StaticResource SecondaryText}" FontSize="12" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Border x:Name="AccountStatusBorder" Grid.Column="1" Background="#373F4A" CornerRadius="12" Padding="13,7" VerticalAlignment="Top">
                                <TextBlock x:Name="AccountStatusText" Text="DISCONNECTED" Foreground="#D1D5DB" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="BALANCE" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="BalanceText" Style="{StaticResource CardValue}" Text="$0.00"/>
                                <TextBlock Text="Closed account balance" Style="{StaticResource HelperText}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="EOD FLOOR" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="FloorText" Style="{StaticResource CardValue}" Text="$0.00"/>
                                <TextBlock Text="Current end-of-day floor" Style="{StaticResource HelperText}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="TODAY'S P&amp;L" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="DailyPnLText" Style="{StaticResource CardValue}" Text="$0.00"/>
                                <TextBlock Text="Realized performance today" Style="{StaticResource HelperText}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="6" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="DAILY RISK" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="DailyLossText" Style="{StaticResource CardValue}" Text="—" FontSize="18"/>
                                <TextBlock Text="Daily loss status" Style="{StaticResource HelperText}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="TRADING DAYS" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="TradingDaysText" Style="{StaticResource CardValue}" Text="0 / 0"/>
                                    <ProgressBar x:Name="TradingDaysProgressBar" Style="{StaticResource ModernProgress}" Margin="0,14,0,0" Maximum="1" Value="0"/>
                                    <TextBlock Text="Minimum completed days" Style="{StaticResource HelperText}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="PROFIT TARGET" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="ProfitTargetText" Style="{StaticResource CardValue}" Text="$0 / $0" Foreground="{StaticResource GoldLight}"/>
                                    <ProgressBar x:Name="ProfitTargetProgressBar" Style="{StaticResource ModernProgress}" Margin="0,14,0,0" Maximum="100" Value="0"/>
                                    <TextBlock Text="Progress toward target" Style="{StaticResource HelperText}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="CONSISTENCY" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="ConsistencyText" Style="{StaticResource CardValue}" Text="0.0%"/>
                                <TextBlock x:Name="ConsistencyBestDayText" Text="Best Day: $0.00" Foreground="{StaticResource SecondaryText}" FontSize="12" Margin="0,8,0,0"/>
                                <ProgressBar x:Name="ConsistencyProgressBar" Style="{StaticResource ModernProgress}" Foreground="{StaticResource Orange}" Margin="0,18,0,0" Maximum="100" Value="0"/>
                                <Border Background="#201B11" BorderBrush="#4A3511" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,18,0,0">
                                    <TextBlock x:Name="ConsistencyRequirementText" Text="Need: $0.00" Foreground="{StaticResource Orange}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource Card}" BorderBrush="#4A3511">
                            <StackPanel>
                                <Grid Margin="0,17,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="CURRENT LEVEL" Style="{StaticResource CardTitle}"/>
                                        <TextBlock x:Name="ProgressionCurrentLevelText" Text="—" Foreground="{StaticResource GoldLight}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="ALLOWED" Style="{StaticResource CardTitle}" HorizontalAlignment="Right"/>
                                        <TextBlock x:Name="ProgressionCurrentContractsText" Text="—" Foreground="{StaticResource PrimaryText}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{StaticResource BorderBrushDark}" Margin="0,16"/>

                                <ItemsControl x:Name="ProgressionStepsItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding RowBackground}" CornerRadius="8" Padding="10,8" Margin="0,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="20" Height="20" Background="{Binding IndicatorBackground}" CornerRadius="10" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding IndicatorText}" Foreground="#111315" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding ProfitText}" Foreground="{Binding PrimaryForeground}" FontWeight="{Binding FontWeight}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding ContractsText}" Foreground="{Binding SecondaryForeground}" FontWeight="{Binding FontWeight}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border x:Name="ProgressionNextLevelPanel" Background="#201B11" BorderBrush="#4A3511" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,16,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="ProgressionRemainingProfitText" Text="—" Foreground="{StaticResource PrimaryText}" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="ProgressionNextContractsText" Text="—" Foreground="{StaticResource SecondaryText}" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="ProgressionMaxLevelText" Text="Progression data unavailable" Foreground="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,13,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="6" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="18,17,18,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="TODAY'S ACTIVITY" Foreground="{StaticResource PrimaryText}" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="Closed trades for the selected account" Foreground="{StaticResource SecondaryText}" FontSize="11" Margin="0,3,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="TradeCountSummaryText" Grid.Column="1" Text="Total Trades: 0" Foreground="{StaticResource SecondaryText}" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock x:Name="WinRateSummaryText" Grid.Column="3" Text="Win Rate: 0.0%" Foreground="{StaticResource SecondaryText}" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TotalPnLSummaryText" Grid.Column="5" Text="Total P&amp;L: $0.00" Foreground="{StaticResource MutedText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Grid.Row="1" Height="1" Background="{StaticResource BorderBrushDark}"/>
                            <Grid Grid.Row="2">
                                <StackPanel x:Name="EmptyTradeLogPanel" Margin="18,30" HorizontalAlignment="Center">
                                    <TextBlock x:Name="EmptyTradeLogText" Text="No closed trades today" Foreground="{StaticResource SecondaryText}" FontSize="13" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Activity will appear here as trades are completed." Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Grid x:Name="TradeLogPanel" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Background="#14171B" Margin="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="0.9*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="TIME" Style="{StaticResource CardTitle}" Margin="18,11"/>
                                        <TextBlock Grid.Column="1" Text="INSTRUMENT" Style="{StaticResource CardTitle}" Margin="8,11"/>
                                        <TextBlock Grid.Column="2" Text="SIDE" Style="{StaticResource CardTitle}" Margin="8,11"/>
                                        <TextBlock Grid.Column="3" Text="QTY" Style="{StaticResource CardTitle}" Margin="8,11"/>
                                        <TextBlock Grid.Column="4" Text="ENTRY" Style="{StaticResource CardTitle}" Margin="8,11"/>
                                        <TextBlock Grid.Column="5" Text="EXIT" Style="{StaticResource CardTitle}" Margin="8,11"/>
                                        <TextBlock Grid.Column="6" Text="P&amp;L" Style="{StaticResource CardTitle}" Margin="8,11"/>
                                        <TextBlock Grid.Column="7" Text="DURATION" Style="{StaticResource CardTitle}" Margin="8,11"/>
                                        <TextBlock Grid.Column="8" Text="RESULT" Style="{StaticResource CardTitle}" Margin="8,11"/>
                                    </Grid>
                                    <ItemsControl x:Name="TradeLogItems" Grid.Row="1">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1" Padding="0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.1*"/>
                                                            <ColumnDefinition Width="1.1*"/>
                                                            <ColumnDefinition Width="0.8*"/>
                                                            <ColumnDefinition Width="0.8*"/>
                                                            <ColumnDefinition Width="1*"/>
                                                            <ColumnDefinition Width="1*"/>
                                                            <ColumnDefinition Width="1*"/>
                                                            <ColumnDefinition Width="1*"/>
                                                            <ColumnDefinition Width="0.9*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Time}" Foreground="{StaticResource SecondaryText}" Margin="18,0" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Instrument}" Foreground="{StaticResource PrimaryText}" Margin="8,0" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="2" Background="{Binding SideBackground}" CornerRadius="8" Padding="7,3" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Side}" Foreground="{Binding SideForeground}" FontSize="10" FontWeight="Bold"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="3" Text="{Binding Contracts}" Foreground="{StaticResource SecondaryText}" Margin="8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding Entry}" Foreground="{StaticResource SecondaryText}" Margin="8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding Exit}" Foreground="{StaticResource SecondaryText}" Margin="8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="6" Text="{Binding PnL}" Foreground="{Binding PnLForeground}" FontWeight="SemiBold" Margin="8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="7" Text="{Binding Duration}" Foreground="{StaticResource SecondaryText}" Margin="8,0" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="8" Background="{Binding ResultBackground}" CornerRadius="8" Padding="7,3" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Result}" Foreground="{Binding ResultForeground}" FontSize="10" FontWeight="Bold"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
        <local:DashboardV2
    x:Name="PremiumDashboard"
    Visibility="Visible"
    Panel.ZIndex="100"/>
    </Grid>
</Window>
